# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# API
VITE_API_URL=https://snaprec-489525905608.us-central1.run.app

# Google AdSense
VITE_ADSENSE_CLIENT_ID=ca-pub-XXXXXXXXXXXXXXXX
VITE_ADSENSE_EDITOR_SLOT=XXXXXXXXXX
VITE_ADSENSE_SHARE_SLOT=XXXXXXXXXX
VITE_ADSENSE_DASHBOARD_SLOT=XXXXXXXXXX

# Chrome Web Store extension ID. Used only to ping the extension for the
# connectivity states on Home (H5).
#
# Must be set, and is checked in with a real value because it is a public
# identifier rather than a secret. Leaving it blank does not degrade to a
# neutral state: the ping is never sent, so every Chromium user is told the
# extension is not installed even when it is working. Vite inlines VITE_* at
# build time, so this also has to exist in the Cloudflare Pages build env.
VITE_EXTENSION_ID=lgafjgnifbjeafallnkkfpljgbilfajg

# PostHog analytics.
#
# Vite only exposes vars prefixed VITE_ and inlines them at BUILD time, so the
# POSTHOG_API_KEY value must be set here as VITE_POSTHOG_API_KEY and must exist
# in the Cloudflare Pages build environment — a runtime-only env var will not
# reach the bundle.
#
# A PostHog *project* API key is a publishable client credential: it ships in the
# JS bundle by design and can only write events. It is not a secret in the way a
# personal API key is. Leave it unset to disable analytics entirely — src/lib/
# analytics.ts skips init and every capture call becomes a no-op.
VITE_POSTHOG_API_KEY=phc_your_project_key
VITE_POSTHOG_HOST=https://us.i.posthog.com
