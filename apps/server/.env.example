DB_HOST=your-supabase-db-host
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your-password
DB_NAME=postgres
# Cloud Run provides PORT=8080 automatically. Use 3001 for local development.
PORT=3001

# Cloudflare R2
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET_NAME=your-bucket-name

# Supabase (Auth)
SUPABASE_URL=https://your-project.supabase.co

# CORS
ALLOWED_ORIGINS=https://www.snaprecorder.org,https://snaprecorder.org,http://localhost:5173

# Chrome Web Store user count (update periodically from CWS dashboard)
CHROME_STORE_USERS=123

# Resend (Email)
RESEND_API_KEY=re_your_api_key
RESEND_FROM_EMAIL=SnapRec <welcome@snaprecorder.org>
FOUNDER_REPLY_TO=founder@snaprecorder.org

# Broadcast scripts (optional)
# LAUNCH_DATE_TEXT=Tuesday, March 18
# TEST_EMAIL=you@gmail.com   # launch script: send to this address only
# EXTENSION_URL=...  # optional; else uses apps/web/.env (merged by send-video-editor-launch script)

# Loops.so (bulk email audience sync)
# Both are REQUIRED for the signup -> Loops sync to run. If either is missing the
# server logs "Loops contact sync is disabled" at startup and every contact is
# silently skipped — no error, nothing in Loops. These must also be set on the
# Cloud Run service, not just here.
LOOPS_API_KEY=your-loops-api-key
LOOPS_MAILING_LIST_ID=your-mailing-list-id
# Internal domains never synced to Loops (comma-separated, '@' optional).
# Defaults to codingcops.com when unset — see DEFAULT_EXCLUDED_DOMAINS.
# EXCLUDED_DOMAINS=codingcops.com

# Upload reservations (requires AddUploadGrants migration and coordinated clients)
UPLOAD_MAX_BYTES=536870912
UPLOAD_DAILY_COUNT=100
UPLOAD_DAILY_BYTES=2147483648
# Set ONLY to your verified reverse-proxy hop count; zero does not trust forwarding.
TRUST_PROXY_HOPS=0
